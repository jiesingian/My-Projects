# The backstop under the triage workflow.
#
# Triage is a workflow, and a workflow can be edited by whoever opens the pull
# request. This file is enforced by GitHub itself: once "require review from
# Code Owners" is on for main, a pull request touching any path below cannot
# merge without Jonathan, whatever any workflow decides. Note the last matching
# rule wins, so order matters here.

# No owner by default — most of the app merges on green CI and is fixed
# forward if wrong. Only the paths below, where a mistake cannot be undone in
# five minutes, need Jonathan.

# The way into the app.
/kin/src/app/login/                 @jiesingian
/kin/src/app/signup/                @jiesingian
/kin/src/app/verify/                @jiesingian
/kin/src/app/forgot-password/       @jiesingian
/kin/src/app/reset-password/        @jiesingian
/kin/src/app/auth/                  @jiesingian
/kin/src/proxy.ts                   @jiesingian
/kin/src/lib/supabase/              @jiesingian
/kin/src/lib/session.ts             @jiesingian

# Not every server action — only the ones that are a permission or a money
# boundary. The rest are backed by RLS, which the database enforces whether or
# not anyone read the diff.
/kin/src/lib/actions/auth.ts        @jiesingian
/kin/src/lib/actions/family.ts      @jiesingian
/kin/src/lib/actions/billing.ts     @jiesingian
/kin/src/lib/actions/wealth.ts      @jiesingian
/kin/src/lib/actions/drive.ts       @jiesingian
/kin/src/app/api/                   @jiesingian

# Who may use Kin, and what it costs.
/kin/src/lib/access.ts              @jiesingian
/kin/src/lib/billing/               @jiesingian
/kin/src/app/subscribe/             @jiesingian

# Anything that changes the database itself. Migrations are Jonathan's alone —
# they apply when written, not when merged, so review cannot catch them after
# the fact.
*.sql                               @jiesingian

