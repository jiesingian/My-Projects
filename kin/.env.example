NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive linking (Settings → Connected storage). Optional: the app runs
# fine without these, "Connect Google Drive" just explains it isn't configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Server-only. Used exclusively by the Drive OAuth route handlers to read/write
# drive_tokens, which RLS deliberately hides from the anon/authenticated roles.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (Settings -> Notifications). Optional: without these, notification
# switches are saved but nothing is sent. Generate once with
#   npx web-push generate-vapid-keys
# The public key is safe to ship to browsers; the private key is a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com

# Google Calendar linking (Settings → Connected). Uses the same client id and
# secret as Drive; without this redirect, linking says it isn't configured.
GOOGLE_CALENDAR_REDIRECT_URI=

# Kin AI (Ask Kin, flyer scanning). Server-only secret. Optional: without it
# every Kin AI feature says it isn't switched on yet.
ANTHROPIC_API_KEY=

# GIFs in the chat. Server-only. Optional: without it there is no GIF search.
GIPHY_API_KEY=

# A TURN relay for calls on mobile data. Optional. TURN_URLS is comma-separated.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# iPhone push (APNs). Server-only. APNS_BUNDLE_ID defaults to Kin's own;
# APNS_CRITICAL=1 only once Apple grants Critical Alerts.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_CRITICAL=

# Android push (FCM). Server-only. Either the whole service-account key file
# as one value, or the three keys taken from it.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Shared secret the scheduled jobs send to /api/cron/*. Server-only.
CRON_SECRET=

# Kin's public address, for links that leave the app. Defaults to production's.
NEXT_PUBLIC_SITE_URL=

# The ad consent banner. Off unless "on"; a build-time variable.
NEXT_PUBLIC_AD_TRACKING=

# Overrides the process time zone (defaults to the family's, Asia/Manila).
KIN_TZ=
