NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive linking (Settings → Connected storage). Optional: the app runs
# fine without these, "Connect Google Drive" just explains it isn't configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Server-only. Used exclusively by the Drive OAuth route handlers to read/write
# drive_tokens, which RLS deliberately hides from the anon/authenticated roles.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (Settings -> Notifications). Optional: without these, notification
# switches are saved but nothing is sent. Generate once with
#   npx web-push generate-vapid-keys
# The public key is safe to ship to browsers; the private key is a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com
