<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app, which leaves the widget's data here
	     (KinWidgetStore). Xcode's automatic signing registers it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jiesingian.kin</string>
	</array>
</dict>
</plist>
