<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Kin</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jiesingian.kin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kin</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Each is used for what Apple allows it for (App Review 2.5.4), and
	     the App Review notes say so for the reviewer:
	     voip: PushKit, only for a Kin call ringing (KinPushPlugin.swift;
	       lib/apns.ts sends nothing else on it), always reported to CallKit.
	     remote-notification: the silent daily alarm re-sync (KinAlarmSync).
	     audio: a call answered through CallKit keeps its sound when the
	       screen locks or the person leaves Kin, as Apple's CallKit guide
	       asks of a calling app; also a voice note or story keeps playing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Kin uses the camera for video calls with your family, and for photos you add.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kin uses the microphone for calls with your family and for recorded stories.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kin shares where you are with your family only when you choose to, and with an SOS.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Kin saves the videos and pictures you make to your photos.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Kin rings your medicine doses, and the plans, check-ups and bills you choose, like an alarm clock, even when the phone is on silent.</string>
	<key>WKAppBoundDomains</key>
	<array>
		<string>kin-family-app.vercel.app</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Export compliance: Kin uses only the encryption built into iOS (HTTPS,
	     and WebRTC's in the web view), which is exempt. Without this key
	     every TestFlight build waits for the question to be answered by hand
	     in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
