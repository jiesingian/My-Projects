<?xml version="1.0" encoding="utf-8"?>
<!-- The "To-Buy" widget (KinToBuyWidget, KinWidgets.toBuy): the count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kin_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_to_buy"
        android:textColor="@color/kin_widget_tint"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:text="@string/widget_sample_count"
        android:textColor="@color/kin_widget_text"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_count_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_on_the_list"
        android:textColor="@color/kin_widget_secondary"
        android:textSize="12sp" />
</LinearLayout>
